# A drop-in for the karvi daemon under systemd (docs/OPERATIONS.md "The
# shared trees" and "The collection run").
# The packaged unit sandboxes the daemon with ProtectSystem=strict and lets
# it write only under the paths its ReadWritePaths names: the basedir
# candidates, the shared trees under the two system roots, the
# configuration, and the scoreboards. A
# crun.directory elsewhere, a basedir elsewhere, or a spooldir elsewhere
# needs its path listed here. ReadWritePaths merges across files: copy this
# file without its .example suffix to
# ~/.config/systemd/user/karvi-daemon.service.d/crun.conf, uncomment the
# line with the site's directory (the dash makes an absent path ignored
# instead of failing the unit's start), then `systemctl --user
# daemon-reload` and `systemctl --user restart karvi-daemon`.
[Service]
#ReadWritePaths=-/srv/configs
