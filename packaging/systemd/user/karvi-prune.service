[Unit]
Description=Prune finished karvi artifacts of this operator
Documentation=file:/usr/share/doc/karvi/docs/PRUNE.md
# The per-operator retention run (docs/PRUNE.md): karvi-prune.timer starts
# this unit daily. It removes what this
# operator owns, under every private root of the operator's that exists
# (/opt/karvi/users/<user>, /var/lib/karvi/users/<user>, and the home's
# ~/.local/share/karvi: their jobs, transcripts, and state/scoreboards), in
# the site's shared trees, and in the shared scoreboards, and passes every
# other operator's item by. Install both files under
# ~/.config/systemd/user/ and `systemctl --user enable --now
# karvi-prune.timer`. Long-term audit retention is journald's and the central
# forwarder's, not this unit's.

[Service]
Type=oneshot
ExecStart=/usr/bin/karvi-prune --basedir auto --sharedroot auto --scoreboards /dev/shm/karvi/scoreboards --days 31 --minfree 5
NoNewPrivileges=yes
# No file-system sandbox (PrivateTmp, ProtectSystem, ProtectHome): a user
# unit runs with the operator's own view of the files, as the client does, so
# a path means the same to both. A user manager cannot set one up on a host
# that restricts unprivileged user namespaces (Ubuntu's
# kernel.apparmor_restrict_unprivileged_userns) and starts the unit without
# it, silently; confinement is the site's system unit's
# (docs/OPERATIONS.md "Retention").
