[Unit]
Description=karvi per-user orchestration daemon
Documentation=file:/usr/share/doc/karvi/docs/OPERATIONS.md
After=network-online.target

[Service]
Type=simple
# Under systemd the daemon stays: the idle timer (daemon.shutdown-idle-timer,
# 1h by default) is off, since an idle exit is a clean exit that
# Restart=on-failure would not restart, and the next client would then launch
# a daemon outside this unit and its limits. --set outranks every file.
ExecStart=/usr/bin/karvi --set daemon.shutdown-idle-timer=0 daemon serve
Restart=on-failure
RestartSec=2s
NoNewPrivileges=yes
# No file-system sandbox (PrivateTmp, ProtectSystem, ProtectHome): a user
# unit runs with the operator's own view of the files, as the client does, so
# a path means the same to both. A user manager cannot set one up on a host
# that restricts unprivileged user namespaces (Ubuntu's
# kernel.apparmor_restrict_unprivileged_userns) and starts the unit without
# it, silently; confinement is the site's system unit's
# (docs/OPERATIONS.md "Retention").
LimitNOFILE=131072
LimitNPROC=65535
TasksMax=65535
UMask=0077

[Install]
WantedBy=default.target
