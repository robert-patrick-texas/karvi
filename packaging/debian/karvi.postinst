#!/bin/sh
# The package's template unit, karvi-daemon@.service under
# /usr/lib/systemd/system: systemd reloads it, so that an instance's next
# start runs the installed unit and a running daemon's stop takes the
# installed unit's settings at once. Nothing is enabled, started, or
# restarted: the restart after an upgrade is the administrator's
# (docs/EXAMPLES.md chapter 57, issue 16). debhelper makes no snippet for a
# template.
set -e
case "$1" in
  configure|abort-upgrade|abort-deconfigure|abort-remove)
    if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
      systemctl --system daemon-reload >/dev/null || true
    fi
    ;;
esac
#DEBHELPER#
exit 0
