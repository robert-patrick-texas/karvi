#!/usr/bin/make -f
# Built by `make deb` (scripts/build-deb.sh) in a staged copy of the tree,
# never in the tree itself: the package carries bin/'s executables as they
# are, which the script checks against CHECKSUMS.sha256, so nothing here
# builds, tests, cleans, or strips them.
%:
	dh $@

override_dh_auto_clean override_dh_auto_build override_dh_auto_test:

# The executables are built -s -w; a further strip would change the bytes
# the published sums promise.
override_dh_strip override_dh_dwz:

# The documents link to one another by relative paths, and the units name
# them by file: paths; a gzipped document would break both. The example
# configurations stay plain too, under the names the documents give them.
override_dh_compress:
	dh_compress -X.md -X.toml

override_dh_auto_install:
	install -D -m 0755 bin/karvi-linux-amd64 debian/karvi/usr/bin/karvi
	# The two helpers beside karvi: karvi finds
	# karvi-askpass beside its own executable, and an operator runs
	# karvi-prune by hand.
	install -D -m 0755 bin/karvi-askpass-linux-amd64 debian/karvi/usr/bin/karvi-askpass
	install -D -m 0755 bin/karvi-prune-linux-amd64 debian/karvi/usr/bin/karvi-prune
	# The manual pages: karvi's and its words' and karvi-askpass's in
	# section 1, karvi-prune's in 8; dh_compress gzips them.
	install -D -m 0644 -t debian/karvi/usr/share/man/man1 packaging/man/*.1
	install -D -m 0644 packaging/man/karvi-prune.8 debian/karvi/usr/share/man/man8/karvi-prune.8
	# The documents in the tree's layout, so their relative links hold:
	# the top level's, docs/, and the release's records.
	install -D -m 0644 -t debian/karvi/usr/share/doc/karvi *.md
	install -D -m 0644 -t debian/karvi/usr/share/doc/karvi/docs docs/*.md
	install -D -m 0644 -t debian/karvi/usr/share/doc/karvi/release release/*.md
	install -D -m 0644 -t debian/karvi/usr/share/doc/karvi/examples examples/*
	# configs/ in the tree's layout, so the configs/ files the documents
	# name resolve: the two examples as files; reference.toml is a link to
	# its one copy under /usr/share/karvi (karvi.links).
	install -D -m 0644 -t debian/karvi/usr/share/doc/karvi/configs configs/example.toml configs/development.toml
	# The material a site installs by choice, nothing of it active: the
	# units and timers, the cron scripts, the crun hook examples, the
	# tmpfiles rule for the group netops, the reference configuration, and
	# the schemas.
	install -D -m 0644 -t debian/karvi/usr/share/karvi/systemd/user packaging/systemd/user/*.service packaging/systemd/user/*.timer
	install -D -m 0644 -t debian/karvi/usr/share/karvi/systemd/system packaging/systemd/system/*
	install -D -m 0755 -t debian/karvi/usr/share/karvi/cron packaging/cron/*
	install -D -m 0644 -t debian/karvi/usr/share/karvi/crun packaging/crun/*
	install -D -m 0644 -t debian/karvi/usr/share/karvi/tmpfiles.d packaging/tmpfiles.d/*
	install -D -m 0644 configs/reference.toml debian/karvi/usr/share/karvi/reference.toml
	install -D -m 0644 -t debian/karvi/usr/share/karvi/schema schema/*
