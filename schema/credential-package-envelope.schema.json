{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robert-patrick-texas.github.io/karvi/schema/credential-package-envelope-v1.json",
  "title": "karvi credential package envelope schema 1",
  "description": "The credential package envelope: the non-secret outer record; the package itself has no wire form. Closed: an unknown property is a contract change and bumps the counter.",
  "$ref": "#/$defs/envelope",
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "identifier": {"type": "string", "pattern": "^[0-9]{8}T[0-9]{6}\\.[0-9]{6}[+-][0-9]{4}-[0-9a-hjkmnp-tv-z]{20}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "principal": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "username", "uid", "hostname"],
      "properties": {"kind": {"enum": ["operator", "credential-authority"]}, "username": {"type": "string"}, "uid": {"type": "integer"}, "hostname": {"type": "string"}}
    },
    "sealed_payload": {
      "type": "object", "additionalProperties": false,
      "required": ["key_id", "nonce", "ciphertext"],
      "properties": {"key_id": {"type": "string"}, "nonce": {"type": "string", "contentEncoding": "base64"}, "ciphertext": {"type": "string", "contentEncoding": "base64"}}
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["category"],
      "properties": {"category": {"type": "string"}, "safe_value": {"type": "string"}, "value_digest": {"type": "string"}, "pattern": {"type": "string"}, "source": {"type": "string"}, "line": {"type": "integer"}, "credkey": {"type": "string"}}
    },
    "secret_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "locator"],
      "properties": {"provider": {"type": "string"}, "locator": {"type": "string"}, "key_id": {"type": "string"}}
    },
    "credential_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["target_ids", "transports", "ports"],
      "properties": {
        "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "transports": {"type": "array", "minItems": 1, "items": {"enum": ["native", "system", "telnet"]}},
        "ports": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1, "maximum": 65535}}
      }
    },
    "grant_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_id", "method", "device_username", "policy", "backend", "matched_on", "scope", "not_before", "not_after"],
      "properties": {
        "credential_id": {"$ref": "#/$defs/identifier"},
        "method": {"enum": ["embedded-secret", "credential-reference", "signing-agent-delegation"]},
        "device_username": {"type": "string"},
        "policy": {"type": "string"}, "backend": {"type": "string"},
        "matched_on": {"$ref": "#/$defs/match"},
        "reference": {"$ref": "#/$defs/secret_reference"},
        "scope": {"$ref": "#/$defs/credential_scope"},
        "not_before": {"$ref": "#/$defs/timestamp"}, "not_after": {"$ref": "#/$defs/timestamp"}
      }
    },
    "target_credential_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["target_id", "credential_id"],
      "properties": {"target_id": {"type": "string"}, "credential_id": {"$ref": "#/$defs/identifier"}}
    },
    "safe_package_projection": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "package_id", "job_id", "plan_digest", "issuer", "audience", "protection", "issued_at", "expires_at", "grants", "bindings"],
      "properties": {
        "schema_version": {"const": 1},
        "package_id": {"$ref": "#/$defs/identifier"},
        "job_id": {"$ref": "#/$defs/identifier"},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "issuer": {"$ref": "#/$defs/principal"},
        "audience": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "protection": {"enum": ["local-peer", "sealed"]},
        "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "grants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/grant_projection"}},
        "bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target_credential_binding"}}
      }
    },
    "envelope": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "content_type", "package_id", "job_id", "plan_digest", "issuer", "audience", "protection", "issued_at", "expires_at", "package_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "content_type": {"const": "application/vnd.karvi.credential-package.v1"},
        "package_id": {"$ref": "#/$defs/identifier"},
        "job_id": {"$ref": "#/$defs/identifier"},
        "plan_digest": {"$ref": "#/$defs/digest"},
        "issuer": {"$ref": "#/$defs/principal"},
        "audience": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "protection": {"enum": ["local-peer", "sealed"]},
        "issued_at": {"$ref": "#/$defs/timestamp"}, "expires_at": {"$ref": "#/$defs/timestamp"},
        "package_digest": {"$ref": "#/$defs/digest"},
        "sealed": {"$ref": "#/$defs/sealed_payload"}
      },
      "if": {"properties": {"protection": {"const": "sealed"}}},
      "then": {"required": ["sealed"]},
      "else": {"not": {"required": ["sealed"]}}
    }
  }
}
