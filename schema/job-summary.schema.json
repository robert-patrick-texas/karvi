{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://robert-patrick-texas.github.io/karvi/schema/job-summary-v5.json",
  "title": "karvi job summary schema 5",
  "description": "Written at the job's acceptance with the fields required here, and written whole again at its end with the result; a summary with a final_status is a finished job's, and then names every field the then clause requires.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "job_id",
    "activity_id",
    "started_at",
    "dispatch_order",
    "plan_id",
    "plan_digest",
    "mode",
    "kind",
    "address_authority_counts",
    "devices",
    "paths"
  ],
  "if": {
    "required": [
      "final_status"
    ]
  },
  "then": {
    "required": [
      "ended_at",
      "duration_ns",
      "final_status",
      "primary_exit_code",
      "primary_exit_name",
      "terminal_causes",
      "ping",
      "device_counts",
      "requested_command_counts",
      "session_init_counts",
      "halt",
      "output",
      "audit_sink_status",
      "bottleneck",
      "recovery"
    ]
  },
  "properties": {
    "schema_version": {
      "const": 5
    },
    "primary_exit_code": {
      "type": "integer"
    },
    "final_status": {
      "type": "string"
    },
    "plan_id": {
      "type": "string"
    },
    "plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "live",
        "exercise"
      ]
    },
    "kind": {
      "description": "What the operator ran: cmd for a command, crun for a crun, run for a run and a stream's job; an exercise keeps its kind.",
      "enum": [
        "cmd",
        "run",
        "crun"
      ]
    },
    "address_authority_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "job_id": {
      "type": "string"
    },
    "activity_id": {
      "type": "string",
      "minLength": 1
    },
    "started_at": {
      "type": "string"
    },
    "ended_at": {
      "type": "string"
    },
    "duration_ns": {
      "type": "integer"
    },
    "primary_exit_name": {
      "type": "string"
    },
    "terminal_causes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dispatch_order": {
      "type": "string"
    },
    "shuffle_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "outcome": {
            "enum": [
              "success",
              "fail",
              "not_started",
              "incomplete",
              "cancel",
              "ready",
              "not_ready"
            ]
          }
        }
      }
    },
    "device_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "requested_command_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "session_init_counts": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "halt": {},
    "output": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {}
    },
    "collection": {
      "type": "object", "additionalProperties": false, "required": ["directory", "replace", "keep", "devices"],
      "properties": {
        "directory": {"type": "string"}, "replace": {"type": "integer", "minimum": 0}, "keep": {"type": "integer", "minimum": 0},
        "devices": {"type": "object", "additionalProperties": {
          "type": "object", "additionalProperties": false, "required": ["file", "outcome"],
          "properties": {"file": {"type": "string"}, "outcome": {"enum": ["replace", "keep"]}}
        }}
      }
    },
    "audit_sink_status": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {}
    },
    "bottleneck": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "properties": {
        "primary": {"type": "string"},
        "confidence": {"type": "string"},
        "supporting_facts": {"type": "array", "items": {"type": "string"}}
      }
    },
    "cancellation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": ["requested_at", "reason", "requester", "request_id"],
      "properties": {
        "requested_at": {"$ref": "execution-plan.schema.json#/$defs/timestamp"},
        "reason": {"type": "string", "maxLength": 256},
        "requester": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pid", "uid"],
          "properties": {"pid": {"type": "integer"}, "uid": {"type": "integer"}}
        },
        "request_id": {"type": "string"}
      }
    },
    "recovery": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {}
    },
    "paths": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "ping": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "enabled",
        "probes",
        "timeout_ns",
        "devices",
        "probes_sent",
        "replies",
        "timeouts",
        "errors",
        "total_ns"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "method": {
          "enum": [
            "socket",
            "system",
            "unavailable"
          ]
        },
        "capability": {
          "enum": [
            "available",
            "unavailable",
            "not_checked"
          ]
        },
        "probes": {
          "const": 2
        },
        "timeout_ns": {
          "type": "integer",
          "minimum": 1
        },
        "devices": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gated",
            "proceed",
            "proceed_degraded",
            "skip",
            "capability_unavailable"
          ],
          "properties": {
            "gated": {
              "type": "integer"
            },
            "proceed": {
              "type": "integer"
            },
            "proceed_degraded": {
              "type": "integer"
            },
            "skip": {
              "type": "integer"
            },
            "capability_unavailable": {
              "type": "integer"
            }
          }
        },
        "probes_sent": {
          "type": "integer"
        },
        "replies": {
          "type": "integer"
        },
        "timeouts": {
          "type": "integer"
        },
        "errors": {
          "type": "integer"
        },
        "total_ns": {
          "type": "integer"
        }
      }
    }
  }
}
